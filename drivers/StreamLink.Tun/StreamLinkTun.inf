; Research-only unsigned root-enumerated IPv4 raw-IP NDIS miniport.
[Version]
Signature="$Windows NT$"
Class=Net
ClassGuid={4D36E972-E325-11CE-BFC1-08002BE10318}
Provider=%Provider%
DriverVer=10/13/2026,1.0.0.1
CatalogFile=StreamLinkTun.cat
PnpLockdown=1
[Manufacturer]
%Provider%=Models,NTamd64.10.0...22000
[Models.NTamd64.10.0...22000]
%Device%=Install,ROOT\StreamLinkTun
[DestinationDirs]
DriverCopy=13
[Install.NT]
Characteristics=0x1
*IfType=53
*MediaType=19
*PhysicalMediaType=0
EnableDhcp=0
CopyFiles=DriverCopy
AddReg=NetReg
[DriverCopy]
StreamLinkTun.sys
[Install.NT.Services]
AddService=StreamLinkTun,2,Service
[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\StreamLinkTun.sys
LoadOrderGroup=NDIS
[NetReg]
HKR,Ndi,Service,0,"StreamLinkTun"
HKR,Ndi\Interfaces,UpperRange,0,"ndis5"
HKR,Ndi\Interfaces,LowerRange,0,"nolower"
HKR,,*IfType,0x00010001,53
HKR,,*MediaType,0x00010001,19
HKR,,*PhysicalMediaType,0x00010001,0
[SourceDisksNames]
1=%Disk%
[SourceDisksFiles]
StreamLinkTun.sys=1
[Strings]
Provider="StreamLink contributors"
Device="StreamLink IPv4 Research Adapter"
Disk="StreamLink driver research files"
