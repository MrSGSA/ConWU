<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\StreamLink.Core\StreamLink.Core.csproj" />
    <ProjectReference Include="..\StreamLink.Service\StreamLink.Service.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\streamlink.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Assets\pearl-background.png" /><EmbeddedResource Include="Assets\streamlink.ico" LogicalName="StreamLink.AppIcon.ico" /></ItemGroup>

</Project>
