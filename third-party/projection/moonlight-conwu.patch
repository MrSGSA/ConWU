+static QJsonValue projectionDropPoint(SDL_Window* window, HWND child, int width, int height)
+{
+    int x, y;
+    if (!ConwuProjection::clientPointer(window, child, x, y)) {
+        return {};
+    }
+
+    SDL_Rect source{0, 0, width, height};
+    SDL_Rect video{};
+    SDL_GetWindowSize(window, &video.w, &video.h);
+    StreamUtils::scaleSourceToDestinationSurface(&source, &video);
+    if (video.w <= 0 || video.h <= 0 || video.w > 32767 || video.h > 32767 ||
+        x < video.x || x >= video.x + video.w || y < video.y || y >= video.y + video.h) {
+        return {};
+    }
+
+    const int offsetX = x - video.x;
+    const int offsetY = y - video.y;
+    // Sunshine applies its active display and letterbox transform to this position.
+    if (LiSendMousePositionEvent(short(offsetX), short(offsetY), short(video.w), short(video.h)) != 0) {
+        return {};
+    }
+    return QJsonObject{
+        {"x", int(qint64(offsetX) * 65535 / video.w)},
+        {"y", int(qint64(offsetY) * 65535 / video.h)},
+        {"width", width},
+        {"height", height},
+    };
+}
