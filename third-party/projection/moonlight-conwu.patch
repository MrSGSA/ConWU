-    // override whatever the preferences say and do it. If the
-    // caller doesn't override to force quit, let the preferences
-    // dictate what we do.
-    if (quitHostApp) {
-        m_Preferences->quitAppAfter = true;
-    }
-
-    m_ShouldExit = true;
