-bool D3D11VARenderer::setupVideoTexture(AVHWFramesContext* framesContext)
-{
-    SDL_assert(!m_BindDecoderOutputTextures);
-
-    HRESULT hr;
-    D3D11_TEXTURE2D_DESC texDesc = {};
-
-    texDesc.Width = framesContext->width;
