+SDL_Point OverlayManager::debugPosition(int viewportWidth, int viewportHeight, int width, int height)
+{
+#ifdef Q_OS_WIN32
+    if (ConwuProjection::requested()) {
+        const int rightMargin = 12;
+        const int bottomMargin = SDL_max(12, viewportHeight / 10);
+        return {SDL_max(0, viewportWidth - width - rightMargin),
+                SDL_max(0, viewportHeight - height - bottomMargin)};
+    }
+#else
+    Q_UNUSED(viewportWidth)
+    Q_UNUSED(viewportHeight)
+    Q_UNUSED(width)
+    Q_UNUSED(height)
+#endif
+    return {0, 0};
+}
+
+#ifdef Q_OS_WIN32
+static SDL_Surface* projectionStatsPanel(const char* text, int fontSize)
+{
+    if (!*text) {
+        return nullptr;
+    }
+    const auto rows = QString::fromUtf8(text).split(QLatin1Char('\n'));
+    QFont font(QStringLiteral("Segoe UI"));
+    font.setPixelSize(fontSize);
+    font.setWeight(QFont::Normal);
+    const QFontMetrics metrics(font);
+    constexpr int horizontalPadding = 10;
+    constexpr int verticalPadding = 7;
+    const int rowHeight = metrics.height() + 2;
+    int width = 0;
+    for (const auto& row : rows) {
+        width = qMax(width, metrics.horizontalAdvance(row));
+    }
+    auto surface = SDL_CreateRGBSurfaceWithFormat(0, width + 2 * horizontalPadding,
+                                                  int(rows.size()) * rowHeight + 2 * verticalPadding,
+                                                  32, SDL_PIXELFORMAT_ARGB8888);
+    if (!surface) {
+        return nullptr;
+    }
+    QImage image(static_cast<uchar*>(surface->pixels), surface->w, surface->h,
+                 surface->pitch, QImage::Format_ARGB32);
+    image.fill(Qt::transparent);
+    QPainter painter(&image);
+    painter.setRenderHints(QPainter::Antialiasing | QPainter::TextAntialiasing);
+    painter.setPen(Qt::NoPen);
+    painter.setBrush(QColor(12, 16, 22, 160));
+    painter.drawRoundedRect(image.rect(), 7, 7);
+    painter.setFont(font);
+    painter.setPen(QColor(248, 249, 251));
+    int baseline = verticalPadding + metrics.ascent();
+    for (const auto& row : rows) {
+        painter.drawText(horizontalPadding, baseline, row);
+        baseline += rowHeight;
+    }
+    return surface;
+}
+#endif
