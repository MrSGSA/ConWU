+class ProjectionEndingView final : public QWindow
+{
+public:
+    explicit ProjectionEndingView(QImage frame) : m_BackBuffer(this), m_Frame(std::move(frame))
+    {
+        setFlags(Qt::FramelessWindowHint | Qt::WindowDoesNotAcceptFocus | Qt::WindowTransparentForInput);
+        auto timer = new QTimer(this);
+        connect(timer, &QTimer::timeout, this, [this] {
+            m_Dots = m_Dots % 3 + 1;
+            if (isExposed()) {
+                present();
+            }
+        });
+        timer->start(400);
+    }
+
+    void present()
+    {
+        if (size().isEmpty()) {
+            return;
+        }
+        m_BackBuffer.resize(size());
+        const QRegion area(QRect(QPoint(0, 0), size()));
+        m_BackBuffer.beginPaint(area);
+        {
+            QPainter painter(m_BackBuffer.paintDevice());
+            paintFrame(painter);
+        }
+        m_BackBuffer.endPaint();
+        m_BackBuffer.flush(area);
+    }
+
+protected:
+    void exposeEvent(QExposeEvent*) override
+    {
+        if (isExposed()) {
+            present();
+        }
+    }
+
+    void resizeEvent(QResizeEvent*) override
+    {
+        if (isExposed()) {
+            present();
+        }
+    }
+
+    bool nativeEvent(const QByteArray&, void* message, qintptr* result) override
+    {
+        const auto native = static_cast<MSG*>(message);
+        if (native->message == WM_ERASEBKGND) {
+            *result = 1;
+            return true;
+        }
+        if (native->message == ConwuProjection::SyncInput) {
+            ConwuProjection::resizeToSurface(native->hwnd);
+            return true;
+        }
+        if (native->message == WM_CLOSE) {
+            if (GetPropW(native->hwnd, ConwuProjection::SessionEndedProperty)) {
+                QCoreApplication::quit();
+            }
+            *result = 0;
+            return true;
+        }
+        return false;
+    }
+
+private:
+    void paintFrame(QPainter& painter)
+    {
+        const QRect bounds(QPoint(0, 0), size());
+        painter.fillRect(bounds, QColor(14, 21, 28));
+        QRect video(QPoint(0, 0), m_Frame.size().scaled(size(), Qt::KeepAspectRatio));
+        video.moveCenter(bounds.center());
+        painter.setRenderHint(QPainter::SmoothPixmapTransform);
+        painter.drawImage(video, m_Frame);
+        painter.setRenderHint(QPainter::Antialiasing);
+        QRect label(0, 0, 126, 34);
+        label.moveCenter(bounds.center());
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(QColor(12, 16, 22, 218));
+        painter.drawRoundedRect(label, 8, 8);
+        auto font = painter.font();
+        font.setPixelSize(16);
+        painter.setFont(font);
+        painter.setPen(QColor(247, 248, 250));
+        painter.drawText(label.adjusted(18, 0, -12, 0), Qt::AlignVCenter | Qt::AlignLeft,
+                         QStringLiteral("正在结束") + QString(m_Dots, QLatin1Char('.')));
+    }
+
+    QBackingStore m_BackBuffer;
+    QImage m_Frame;
+    int m_Dots = 1;
+};
+
+static QWindow* showProjectionEndingFrame(QImage frame)
+{
+    RECT area{};
+    if (frame.isNull() || !GetClientRect(ConwuProjection::surface(), &area) || area.right <= 0 || area.bottom <= 0) {
+        return nullptr;
+    }
+    const auto videoSize = frame.size();
+    auto view = std::make_unique<ProjectionEndingView>(std::move(frame));
+    view->resize(area.right, area.bottom);
+    auto child = reinterpret_cast<HWND>(view->winId());
+    if (ConwuProjection::attach(child, ConwuProjection::WaitForFrameProperty, false)) {
+        SetPropW(child, ConwuProjection::StoppingProperty, reinterpret_cast<HANDLE>(1));
+        view->show();
+        view->present();
+        // Submit the frozen pixels before releasing the original swap chain.
+        DwmFlush();
+        ConwuProjection::framePresented(child, videoSize.width(), videoSize.height());
+        view->QObject::setParent(QCoreApplication::instance());
+        return view.release();
+    }
+    return nullptr;
+}
+
+bool Session::finishProjectionEndingView()
+{
+    if (!m_ProjectionEndingView || !m_ProjectionEndingView->handle()) {
+        return false;
+    }
+    const auto child = reinterpret_cast<HWND>(m_ProjectionEndingView->winId());
+    if (GetParent(child) != ConwuProjection::surface() ||
+        !SetPropW(child, ConwuProjection::SessionEndedProperty, reinterpret_cast<HANDLE>(1))) {
+        return false;
+    }
+    // The panel closes this window after painting its idle state. A hidden or
+    // older panel may never acknowledge, so the player still exits on its own.
+    QTimer::singleShot(1800, QCoreApplication::instance(), &QCoreApplication::quit);
+    return true;
+}
