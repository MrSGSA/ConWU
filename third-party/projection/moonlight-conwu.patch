diff --git a/app/conwu_projection.h b/app/conwu_projection.h
new file mode 100644
index 0000000..eff5923
--- /dev/null
+++ b/app/conwu_projection.h
@@ -0,0 +1,199 @@
+#pragma once
+
+#include <QtGlobal>
+
+#ifdef Q_OS_WIN32
+#include <qt_windows.h>
+#include "SDL_compat.h"
+#if !SDL_VERSION_ATLEAST(3, 0, 0)
+#include <SDL_syswm.h>
+#endif
+#include <cwchar>
+
+namespace ConwuProjection {
+constexpr UINT SyncSurface = WM_APP + 85;
+constexpr UINT ToggleFullscreen = WM_APP + 87;
+constexpr UINT SyncInput = WM_APP + 88;
+constexpr UINT ToggleStats = WM_APP + 89;
+constexpr Sint32 InputEvent = 106;
+constexpr Sint32 ReleaseInputEvent = 107;
+constexpr Sint32 ToggleStatsEvent = 108;
+constexpr auto SurfaceClass = L"ConWU.Projection.Surface";
+constexpr auto ViewerProperty = L"ConWU.Projection.Moonlight";
+constexpr auto FullscreenProperty = L"ConWU.Projection.Fullscreen";
+constexpr auto WaitForFrameProperty = L"ConWU.Projection.WaitForFrame";
+constexpr auto StoppingProperty = L"ConWU.Projection.Stopping";
+constexpr auto SessionEndedProperty = L"ConWU.Projection.SessionEnded";
+constexpr auto InputBlockedProperty = L"ConWU.Projection.InputBlocked";
+constexpr auto VideoWidthProperty = L"ConWU.Projection.VideoWidth";
+constexpr auto VideoHeightProperty = L"ConWU.Projection.VideoHeight";
+
+inline bool requested()
+{
+    return qEnvironmentVariableIsSet("CONWU_PROJECTION_SURFACE");
+}
+
+inline HWND surface()
+{
+    static const HWND handle = [] {
+        bool ok = false;
+        auto value = qEnvironmentVariable("CONWU_PROJECTION_SURFACE").toULongLong(&ok);
+        return ok ? reinterpret_cast<HWND>(static_cast<quintptr>(value)) : nullptr;
+    }();
+    return handle;
+}
+
+inline bool validSurface()
+{
+    wchar_t name[64]{};
+    return surface() && GetClassNameW(surface(), name, 64) > 0
+           && std::wcscmp(name, SurfaceClass) == 0;
+}
+
+inline HWND handle(SDL_Window* window)
+{
+    SDL_SysWMinfo info{};
+    SDL_VERSION(&info.version);
+    return SDL_GetWindowWMInfo(window, &info) && info.subsystem == SDL_SYSWM_WINDOWS
+           ? info.info.win.window : nullptr;
+}
+
+inline bool clientPointer(SDL_Window* window, HWND child, int& x, int& y)
+{
+    POINT cursor;
+    RECT client;
+    if (!GetCursorPos(&cursor) || !ScreenToClient(child, &cursor) ||
+        !GetClientRect(child, &client) || cursor.x < 0 || cursor.y < 0 ||
+        cursor.x >= client.right || cursor.y >= client.bottom) {
+        return false;
+    }
+    int width, height;
+    SDL_GetWindowSize(window, &width, &height);
+    x = int(qint64(cursor.x) * width / client.right);
+    y = int(qint64(cursor.y) * height / client.bottom);
+    return true;
+}
+
+inline bool fullscreen()
+{
+    return surface() && GetPropW(surface(), FullscreenProperty) != nullptr;
+}
+
+inline bool inputAvailable(HWND child)
+{
+    return IsWindowVisible(child) && IsWindowEnabled(surface()) &&
+           !GetPropW(surface(), InputBlockedProperty) && !GetPropW(child, StoppingProperty) &&
+           GetForegroundWindow() == GetAncestor(child, GA_ROOT);
+}
+
+inline void resizeToSurface(HWND child)
+{
+    RECT parentArea{}, childArea{};
+    if (GetParent(child) == surface() && GetClientRect(surface(), &parentArea) &&
+        GetClientRect(child, &childArea) &&
+        (parentArea.right != childArea.right || parentArea.bottom != childArea.bottom)) {
+        SetWindowPos(child, nullptr, 0, 0, parentArea.right, parentArea.bottom,
+                     SWP_NOMOVE | SWP_NOACTIVATE | SWP_NOZORDER);
+    }
+}
+
+inline void framePresented(HWND child, int width, int height)
+{
+    SetPropW(child, VideoWidthProperty, reinterpret_cast<HANDLE>(quintptr(width)));
+    SetPropW(child, VideoHeightProperty, reinterpret_cast<HANDLE>(quintptr(height)));
+    if (RemovePropW(child, WaitForFrameProperty)) {
+        PostMessageW(GetParent(child), SyncSurface, 0, 0);
+    }
+}
+
+inline bool attach(HWND child, const wchar_t* stateProperty, bool interactive = true)
+{
+    if (!child || !validSurface()) {
+        return false;
+    }
+    RECT area{};
+    if (!GetClientRect(surface(), &area) || area.right < 1 || area.bottom < 1) {
+        return false;
+    }
+    SetWindowLongPtrW(child, GWL_STYLE,
+                     WS_CHILD | WS_CLIPSIBLINGS | WS_CLIPCHILDREN | (interactive ? 0 : WS_DISABLED));
+    const auto extended = GetWindowLongPtrW(child, GWL_EXSTYLE) & ~WS_EX_APPWINDOW;
+    SetWindowLongPtrW(child, GWL_EXSTYLE,
+                      interactive ? extended : extended | WS_EX_NOACTIVATE | WS_EX_TRANSPARENT);
+    SetParent(child, surface());
+    if (GetParent(child) != surface() ||
+        !SetPropW(child, stateProperty, reinterpret_cast<HANDLE>(1)) ||
+        !SetPropW(child, ViewerProperty, reinterpret_cast<HANDLE>(1)) ||
+        !SetWindowPos(child, HWND_TOP, 0, 0, area.right, area.bottom, SWP_FRAMECHANGED | SWP_NOACTIVATE)) {
+        return false;
+    }
+    PostMessageW(surface(), SyncSurface, 0, 0);
+    return true;
+}
+
+inline bool attach(SDL_Window* window)
+{
+    return attach(handle(window), WaitForFrameProperty);
+}
+
+inline void pushEvent(Sint32 code)
+{
+    SDL_Event event{};
+    event.type = SDL_USEREVENT;
+    event.user.code = code;
+    SDL_PushEvent(&event);
+}
+
+inline void pushCloseEvent()
+{
+    SDL_Event event{};
+    event.type = SDL_QUIT;
+    SDL_PushEvent(&event);
+}
+
+inline void focusOnMouseDown(HWND child, UINT message)
+{
+    if ((message == WM_LBUTTONDOWN || message == WM_RBUTTONDOWN ||
+         message == WM_MBUTTONDOWN) && GetFocus() != child &&
+        inputAvailable(child)) {
+        SetFocus(child);
+    }
+}
+
+inline bool handleInputMessage(HWND child, UINT message)
+{
+    focusOnMouseDown(child, message);
+    switch (message) {
+    case SyncInput:
+        resizeToSurface(child);
+        pushEvent(InputEvent);
+        return true;
+    case ToggleStats:
+        pushEvent(ToggleStatsEvent);
+        return true;
+    case WM_CANCELMODE:
+        pushEvent(ReleaseInputEvent);
+        return false;
+    case WM_CLOSE:
+        pushCloseEvent();
+        return true;
+    default:
+        return false;
+    }
+}
+
+#if SDL_VERSION_ATLEAST(3, 0, 0)
+inline bool SDLCALL windowMessage(void* child, MSG* message)
+{
+    return message->hwnd != child || !handleInputMessage(message->hwnd, message->message);
+}
+#else
+inline void SDLCALL windowMessage(void* child, void* hwnd, unsigned int message, Uint64, Sint64)
+{
+    if (hwnd == child) {
+        handleInputMessage(static_cast<HWND>(hwnd), message);
+    }
+}
+#endif
+}
+#endif
